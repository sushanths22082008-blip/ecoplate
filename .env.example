# EcoPlate does NOT read this file automatically (no extra dependency). Use it as a checklist and set each variable in your terminal
# (Windows PowerShell: $env:NAME="value"   macOS/Linux: export NAME="value") or in the Render dashboard. Never commit real values.
ECOPLATE_ACCESS_CODE=change-me-to-a-long-code
ECOPLATE_SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
# ECOPLATE_ADMIN_CODE=another-long-code
# ECOPLATE_DB=/var/data/ecoplate.db
# ECOPLATE_TIMEZONE=Asia/Kolkata
# ANTHROPIC_API_KEY=sk-ant-...
# ECOPLATE_LLM_DAILY_LIMIT=200
# ECOPLATE_COOKIE_SECURE=0     # only for http://localhost
