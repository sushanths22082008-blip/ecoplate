# Copy this file to a file named `.env` (same folder as app.py) and fill in real values. `python app.py` and gunicorn read `.env` when they
# start (needs python-dotenv, listed in requirements.txt). Variables already set in the terminal or in the Render dashboard take priority.
# NEVER commit `.env` or paste real values into this example file.
ECOPLATE_ACCESS_CODE=change-me-to-a-long-code
ECOPLATE_SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
# ECOPLATE_ADMIN_CODE=another-long-code
# ECOPLATE_DB=/var/data/ecoplate.db
# ECOPLATE_TIMEZONE=Asia/Kolkata
# ANTHROPIC_API_KEY=sk-ant-...
# ECOPLATE_LLM_DAILY_LIMIT=200
# ECOPLATE_COOKIE_SECURE=0     # only for http://localhost

# PostgreSQL (Neon). Leave unset to keep using the local SQLite file ecoplate.db.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
